<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- 最新正式版 4.1.0；Spring Framework 7.0.8 / Spring Security 7.1.0 由 Boot BOM 管理 -->
    </parent>

    <groupId>xyz.nanian</groupId>
    <artifactId>OWL</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>OWL</name>
    <description>持续开发</description>

    <modules>
        <module>common</module>
        <module>api</module>
        <module>start</module>
        <module>log</module>
        <module>infra</module>
        <module>watermelon</module>
        <module>watermelon/administration</module>
        <module>watermelon/user</module>
        <module>watermelon/sugarcane</module>
        <module>watermelon/crow</module>
        <module>watermelon/mango</module>
        <module>watermelon/caishen</module>
    </modules>


    <properties>
<!--        项目版本-->
        <revision>0.0.1</revision>
<!--        依赖版本-->
        <java.version>25</java.version>
        <easyexcel.version>4.0.3</easyexcel.version>
        <mybatis.plus.version>3.5.17</mybatis.plus.version>
        <spring.cloud.version>2025.1.2</spring.cloud.version>
        <nacos.config.discovery.version>2025.1.0.0</nacos.config.discovery.version>
        <swagger.version>2.8.14</swagger.version>
        <knife4j.version>5.2.3</knife4j.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <druid.version>1.2.28</druid.version>
        <rocketmq.version>2.3.6</rocketmq.version>
        <jwt.version>0.13.0</jwt.version>
        <mybatis.generator.version>3.5.14</mybatis.generator.version>
        <mybatis.generator.plugin.version>2.0.0</mybatis.generator.plugin.version>
        <velocity.engine.version>2.4.1</velocity.engine.version>
        <spring.ai.model.version>2.0.0</spring.ai.model.version>
        <minio.version>9.0.3</minio.version>
        <redis.guava.bloom.version>33.6.0-jre</redis.guava.bloom.version>
    </properties>


    <dependencyManagement>
        <dependencies>
            <!--            依赖模块-->
            <!--            自建模块-->
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>user</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>log</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>watermelon</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>sugarcane</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>crow</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>administration</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>mango</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>caishen</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>xyz.nanian</groupId>
                <artifactId>infra</artifactId>
                <version>${revision}</version>
            </dependency>


            <!--            子模块如果要使用依赖，要声明依赖，但是不用声明版本，版本管理中心-->
            <!--            https://mvnrepository.com/artifact/com.alibaba/easyexcel -->

            <!--            Spring Boot 4 使用 boot4 starter；3.5.17 修复 JDK 9+ 模块化包名问题 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>
            <!--            ai-->
            <!--            Spring AI 2.0 为 Boot 4 系列，2.x 对 ChatOptions / Tool API 有破坏性变更 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-starter-model-openai</artifactId>
                <version>${spring.ai.model.version}</version>
            </dependency>

            <!--            中间件-->
            <!--            rocketMQ-->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <!--            nacos -->
            <!--            Boot 4.1 要求 Spring Cloud 2025.1.2；BOM 先声明，确保覆盖 SCA 带入的 Cloud 2025.1.0 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
<!--            这里红色警告就是这个依赖中的某个包太老了，等以后更新，但只是警告，不影响使用，-->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${nacos.config.discovery.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>


            <!--            日志-->
            <!--            knife4j 官方尚未适配 Boot 4；5.2.3 为已发布到 Maven Central 的社区维护分支 -->
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <!--            MapStruct-->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>


            <!--            DataBase-->
            <!--            MP -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis.generator.version}</version>
            </dependency>
            <!--            Pagination plugin moved to a separate module since 3.5.9 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>
            <!--            Boot 4 需使用 druid-spring-boot-4-starter -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>


            <!--            其他的-->
            <!--            jwt-->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <!--            Java 模板引擎，-->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity.engine.version}</version>
            </dependency>
            <!--            easyexcel -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${redis.guava.bloom.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>


        </plugins>
    </build>

</project>
